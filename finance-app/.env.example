# Environment configuration for finance-app
# Copy this file to .env and adjust the values as needed.
# Never commit .env to source control.

# Set to "false" to switch from fixture data to the live Yahoo Finance proxy.
# Any other value (or omitting it entirely) keeps mock mode active.
# Required to be absent or "true" for CI, offline development, and Jest tests.
VITE_USE_MOCK=true

# Base URL for the local Express proxy server.
# Only relevant when VITE_USE_MOCK=false.
# The proxy bridges browser React code to yahoo-finance2 (Node.js only).
# Start the proxy with: npm run server
VITE_PROXY_URL=http://localhost:3001

# Vite dev server port (optional — defaults to 3000 in vite.config.js)
# PORT=3000
